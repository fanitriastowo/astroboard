<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Lost in space — Astroboard</title>
    <style>
      :root {
        --bg: #0a0e1a;
        --ink: #e7eaf7;
        --muted: #7d87ad;
        --line: #26325a;
        --violet: #8b6ff0;
        --grad: linear-gradient(120deg, #8b6ff0 0%, #6f7ef0 45%, #4fd6e0 100%);
        --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --mono: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; }
      body {
        font-family: var(--sans);
        color: var(--ink);
        background:
          radial-gradient(1100px 720px at 12% -8%, rgba(139, 111, 240, 0.20), transparent 60%),
          radial-gradient(1000px 680px at 100% 0%, rgba(79, 214, 224, 0.14), transparent 55%),
          radial-gradient(900px 700px at 80% 110%, rgba(139, 111, 240, 0.12), transparent 60%),
          var(--bg);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        -webkit-font-smoothing: antialiased;
      }
      .card {
        width: min(480px, 100%);
        border: 1px solid rgba(38, 50, 90, 0.9);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(20, 28, 52, 0.6), rgba(12, 17, 32, 0.6));
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        padding: 40px 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 14px;
      }
      .code-404 {
        font-family: var(--mono);
        font-size: 64px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.02em;
        background: var(--grad);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .title {
        font-size: 20px;
        font-weight: 650;
        letter-spacing: -0.01em;
        margin: 0;
      }
      .subtext {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.5;
        margin: 0;
        max-width: 320px;
      }
      .btn {
        margin-top: 8px;
        height: 42px;
        padding: 0 20px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        color: #0a0e1a;
        background: var(--grad);
        box-shadow: 0 8px 22px rgba(111, 126, 240, 0.4);
        transition: box-shadow 0.15s, filter 0.15s;
      }
      .btn:hover { box-shadow: 0 10px 28px rgba(111, 126, 240, 0.55); filter: brightness(1.05); }
      :focus-visible { outline: 2px solid var(--violet); outline-offset: 2px; border-radius: 6px; }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>
  <body>
    <main class="card">
      <span class="code-404">404</span>
      <h1 class="title">Lost in space</h1>
      <p class="subtext">This page drifted out of orbit. Let's get you back.</p>
      <a class="btn" href="/">Back to boards →</a>
    </main>
  </body>
</html>
